{
  "entities": {
    "Artwork": {
      "title": "Artwork",
      "description": "A user-uploaded compressed artwork displayed in the 2D virtual art museum.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Title of the artwork."
        },
        "artistName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50,
          "description": "Display name of the artist/uploader."
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional curatorial note or medium description."
        },
        "imageDataUrl": {
          "type": "string",
          "minLength": 20,
          "maxLength": 920000,
          "description": "Client-compressed image stored as a Data URL strictly under 1MB."
        },
        "compressedSizeBytes": {
          "type": "number",
          "description": "Byte size of the compressed image payload."
        },
        "width": {
          "type": "number",
          "description": "Compressed image pixel width."
        },
        "height": {
          "type": "number",
          "description": "Compressed image pixel height."
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the uploader."
        },
        "status": {
          "type": "string",
          "enum": ["published"],
          "description": "Publication status of the artwork."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when uploaded."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated."
        }
      },
      "required": [
        "title",
        "artistName",
        "imageDataUrl",
        "compressedSizeBytes",
        "width",
        "height",
        "authorUid",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "ArtworkComment": {
      "title": "ArtworkComment",
      "description": "A visitor appreciation review left on an uploaded artwork.",
      "type": "object",
      "properties": {
        "artworkId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Parent artwork document ID."
        },
        "visitorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Name entered by the visitor."
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Visitor appreciation note or review."
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the commenter, or 'guest' when posted without login."
        },
        "status": {
          "type": "string",
          "enum": ["visible"],
          "description": "Visibility status of the comment."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated."
        }
      },
      "required": [
        "artworkId",
        "visitorName",
        "content",
        "authorUid",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "CuratedReview": {
      "title": "CuratedReview",
      "description": "A visitor appreciation review left on a permanent curated exhibition piece.",
      "type": "object",
      "properties": {
        "curatedId": {
          "type": "string",
          "enum": [
            "curated-solstice",
            "curated-botanical",
            "curated-nocturne",
            "curated-terracotta"
          ],
          "description": "Identifier of the permanent curated artwork."
        },
        "visitorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Name entered by the visitor."
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Visitor appreciation note or review."
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the commenter, or 'guest' when posted without login."
        },
        "status": {
          "type": "string",
          "enum": ["visible"],
          "description": "Visibility status of the review."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when updated."
        }
      },
      "required": [
        "curatedId",
        "visitorName",
        "content",
        "authorUid",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/artworks/{artworkId}": {
      "schema": {
        "$ref": "#/entities/Artwork"
      },
      "description": "Published artworks uploaded by museum visitors, compressed under 1MB."
    },
    "/artworks/{artworkId}/comments/{commentId}": {
      "schema": {
        "$ref": "#/entities/ArtworkComment"
      },
      "description": "Visitor reviews attached to a specific user-uploaded artwork."
    },
    "/curated_reviews/{reviewId}": {
      "schema": {
        "$ref": "#/entities/CuratedReview"
      },
      "description": "Visitor reviews attached to permanent curated exhibition artworks."
    }
  }
}
